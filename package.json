{
  "name": "sivi",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tests/support/static-server.mjs",
    "serve:test": "node tests/support/static-server.mjs",
    "test:unit": "node tests/unit/all.test.js",
    "test:operations": "node tests/operations-browser.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test": "npm run test:unit && npm run test:e2e",
    "build:public": "vite build --config vite.public.config.ts",
    "check:public": "tsc -p tsconfig.public.json",
    "prestart": "npm run build:public",
    "preserve:test": "npm run build:public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@number-flow/react": "^0.6.2",
    "gsap": "^3.15.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
